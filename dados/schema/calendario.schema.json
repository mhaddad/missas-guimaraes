{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missasemguimaraes.pt/schema/calendario.schema.json",
  "title": "Calendário litúrgico e civil (dados/calendario.yml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dias_santos_de_preceito",
    "anos"
  ],
  "properties": {
    "dias_santos_de_preceito": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estado",
        "regras"
      ],
      "properties": {
        "estado": {
          "type": "string"
        },
        "regras": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/regra_dia_santo"
          }
        },
        "nao_incluidos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "anos": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\d{4}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/ano"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "regra_dia_santo": {
      "oneOf": [
        {
          "$ref": "#/$defs/regra_dia_santo_fixa"
        },
        {
          "$ref": "#/$defs/regra_dia_santo_movel"
        }
      ]
    },
    "ano": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dias_santos",
        "moveis",
        "hora_legal"
      ],
      "properties": {
        "dias_santos": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/data"
          }
        },
        "moveis": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/data"
          }
        },
        "hora_legal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inicio_verao",
            "inicio_inverno"
          ],
          "properties": {
            "inicio_verao": {
              "$ref": "#/$defs/data"
            },
            "inicio_inverno": {
              "$ref": "#/$defs/data"
            }
          }
        }
      }
    },
    "regra_dia_santo_fixa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "data"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nome": {
          "type": "string"
        },
        "data": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
          "description": "Data fixa, MM-DD"
        }
      }
    },
    "regra_dia_santo_movel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "data_movel"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nome": {
          "type": "string"
        },
        "data_movel": {
          "type": "string",
          "pattern": "^pascoa[+-]\\d{1,3}$",
          "description": "Dias a partir da Páscoa, ex.: pascoa+60"
        }
      }
    }
  }
}
