{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/en/",
        "http://localhost:4322/paroquias/",
        "http://localhost:4322/paroquia/nossa-senhora-da-oliveira/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      },
      "startServerCommand": "npm run servidor:e2e",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 120000
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
