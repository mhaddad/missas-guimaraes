{
  "name": "missas-guimaraes",
  "private": true,
  "description": "Horários de Missas e Celebrações — Arciprestado de Guimarães e Vizela",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "pacotes/*",
    "site",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w site",
    "deploy": "npm run build && npm run deploy -w worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w site && npm run typecheck -w worker",
    "validar": "tsx scripts/validar.ts",
    "verificar": "npm run format:check && npm run lint && npm run typecheck && npm run gerados:verificar && npm run test:cobertura && npm run validar",
    "gerar:tipos": "tsx scripts/gerar-tipos.ts",
    "gerar:validadores": "tsx pacotes/dados/scripts/gerar-validadores.ts",
    "formatar:dados": "tsx scripts/formatar-dados.ts",
    "gerados:verificar": "tsx scripts/gerar-tipos.ts --verificar && tsx pacotes/dados/scripts/gerar-validadores.ts --verificar",
    "test:cobertura": "vitest run --coverage",
    "e2e": "playwright test",
    "lighthouse": "npm run build && lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.6"
  }
}
