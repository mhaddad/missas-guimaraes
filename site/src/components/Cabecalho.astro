---
/**
 * Cabeçalho do site e do painel (§6.10): selo compacto (decorativo) e o nome do Arciprestado
 * e da aplicação em texto HTML, legível, traduzível e indexável.
 */
---

<header class="border-b border-borda bg-cartao">
  <div class="mx-auto flex max-w-pagina items-center gap-3 px-4 py-3">
    <img src="/marca/selo-compacto.svg" alt="" width="44" height="42" class="h-11 w-auto" />
    <div>
      <p class="text-base leading-tight font-bold text-ardosia">
        Arciprestado de Guimarães e Vizela
      </p>
      <p class="text-sm leading-tight font-semibold text-dourado-texto">
        Horários de Missas e Celebrações
      </p>
    </div>
  </div>
</header>
