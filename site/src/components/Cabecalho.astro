---
/**
 * Cabeçalho do site e do painel (§6.10): selo compacto (decorativo) e o nome do Arciprestado
 * e da aplicação em texto HTML. No site, também os atalhos e a escolha de idioma (§6.2).
 */
import { IDIOMAS, TEXTOS, type Idioma } from "../i18n/index.ts";

interface Props {
  idioma?: Idioma;
  /** Mostra os atalhos e os idiomas (site público). */
  navegacao?: boolean;
}

const { idioma = "pt-PT", navegacao = false } = Astro.props;
const t = TEXTOS[idioma];
---

<header class="border-b border-borda bg-cartao">
  <div class="mx-auto flex max-w-pagina flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <a href={t.caminho} class="flex min-h-12 items-center gap-3 rounded-cartao">
      <img src="/marca/selo-compacto.svg" alt="" width="44" height="42" class="h-11 w-auto" />
      <span>
        <span class="block text-base leading-tight font-bold text-ardosia">{t.arciprestado}</span>
        <span class="block text-sm leading-tight font-semibold text-dourado-texto">
          {t.aplicacao}
        </span>
      </span>
    </a>
    {navegacao && (
      <>
        <nav aria-label={t.navegacao} class="ml-auto hidden md:block">
          <ul class="flex gap-1">
            <li>
              <a class="atalho" href="#igrejas" data-atalho="paroquias">
                {t.paroquias}
              </a>
            </li>
            <li>
              <a class="atalho" href="#solenidades" data-atalho="solenidades">
                {t.solenidades}
              </a>
            </li>
          </ul>
        </nav>
        <nav aria-label={t.escolherIdioma} class="w-full md:ml-0 md:w-auto">
          <ul class="flex items-center justify-center gap-1 text-sm font-bold md:justify-start">
            {IDIOMAS.map((i) => (
              <li>
                <a
                  class:list={["idioma", i === idioma && "idioma-atual"]}
                  href={TEXTOS[i].caminho}
                  hreflang={TEXTOS[i].idioma}
                  lang={TEXTOS[i].idioma}
                  aria-current={i === idioma ? "page" : undefined}
                  data-idioma={TEXTOS[i].caminho}
                >
                  <span aria-hidden="true">{TEXTOS[i].codigo.toUpperCase()}</span>
                  <span class="sr-only">{TEXTOS[i].nomeIdioma}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </>
    )}
  </div>
</header>
