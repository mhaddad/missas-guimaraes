---
/**
 * Detalhe de um local (§6.5): morada, entidade, telefone, horário semanal, dias santos,
 * próximas alterações, notas e selo. Sem ids: o navegador copia-o para baixo das linhas da
 * vista por hora.
 */
import type { Entidade, Local } from "@missas/horarios";
import { TEXTOS, type Idioma } from "../i18n/index.ts";
import { blocosHorario, descreverExcecao, notasDoLocal } from "../lib/detalhe.ts";
import { ligacaoMapa } from "../lib/portal.ts";
import Icone from "./Icone.astro";
import Selo from "./Selo.astro";

interface Props {
  idioma: Idioma;
  local: Local;
  entidade: Entidade;
  hoje: string;
}

const { idioma, local, entidade, hoje } = Astro.props;
const t = TEXTOS[idioma];
const blocos = blocosHorario(local, idioma, hoje);
const excecoes = local.excecoes.filter((e) => e.data >= hoje).slice(0, 6);
const notas = notasDoLocal(local, idioma);
const telefones = entidade.telefones_publicos ?? [];
const caminho = `${t.caminho}#${local.id}`;
---

<div class="detalhe grid gap-5 pt-4 md:grid-cols-[1fr_1fr]">
  <div class="flex flex-wrap gap-3 md:col-span-2">
    <a
      class="botao-secundario"
      href={ligacaoMapa(local.geo)}
      data-mapa={`${local.geo.lat},${local.geo.lon}`}
      target="_blank"
      rel="noopener"
    >
      <Icone nome="navigation" />
      {t.comoChegar}
    </a>
    <button
      type="button"
      class="botao-secundario"
      data-partilhar={caminho}
      data-titulo={local.nome}
      hidden
    >
      <Icone nome="share" />
      {t.partilhar}
    </button>
    <button type="button" class="botao-secundario" data-relatar={local.id} hidden>
      <Icone nome="flag" />
      {t.reportar}
    </button>
  </div>

  <div class="grid content-start gap-3 text-base">
    <dl class="grid gap-3">
      {local.morada && (
        <div>
          <dt class="font-semibold">{t.morada}</dt>
          <dd class="text-texto-secundario">{local.morada}</dd>
        </div>
      )}
      <div>
        <dt class="font-semibold">{t.responsavel}</dt>
        <dd class="text-texto-secundario">{entidade.nome}</dd>
      </div>
      {telefones.length > 0 && (
        <div>
          <dt class="font-semibold">{t.telefone}</dt>
          <dd>
            {telefones.map((tel) => (
              <a
                class="ligacao mr-3 inline-flex min-h-12 items-center gap-1"
                href={`tel:${tel.replace(/\s/g, "")}`}
              >
                <Icone nome="call" class="size-4" />
                {tel}
              </a>
            ))}
          </dd>
        </div>
      )}
    </dl>
    <div>
      <Selo
        idioma={idioma}
        confirmadoEm={local.confirmado_em}
        tipoEntidade={entidade.tipo}
        hoje={hoje}
        forma="longo"
      />
    </div>
  </div>

  <div class="grid content-start gap-4 text-base">
    <section>
      <h4 class="font-semibold">{t.horarioSemanal}</h4>
      {blocos.length === 0 && <p class="text-texto-secundario">{t.semHorarios}</p>}
      {blocos.map((bloco) => (
        <div class:list={["mt-2", !bloco.atual && "text-texto-secundario"]}>
          {bloco.titulo && (
            <p class="text-sm font-semibold">
              {bloco.titulo}
              {bloco.atual && (
                <span class="ml-1 rounded bg-confirmado-fundo px-1.5 text-xs text-confirmado">
                  {t.epocaAtual}
                </span>
              )}
            </p>
          )}
          <ul class="mt-1 list-disc space-y-0.5 pl-5">
            {bloco.linhas.map((l) => (
              <li>
                {l.texto}
                {l.nota && (
                  <span class="text-texto-secundario">
                    {" "}
                    — {l.nota}
                    {l.notaEmPortugues && ` ${t.emPortugues}`}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
    <section>
      <h4 class="font-semibold">{t.diasSantosTitulo}</h4>
      <p class="text-texto-secundario">{t.regimes[local.dias_santos ?? "null"]}</p>
    </section>
    {excecoes.length > 0 && (
      <section>
        <h4 class="font-semibold">{t.proximasAlteracoes}</h4>
        <ul class="mt-1 list-disc pl-5">
          {excecoes.map((e) => (
            <li>{descreverExcecao(e, idioma)}</li>
          ))}
        </ul>
      </section>
    )}
    {notas.length > 0 && (
      <section>
        <h4 class="font-semibold">{t.notas}</h4>
        <ul class="mt-1 list-disc pl-5">
          {notas.map((n) => (
            <li>
              {n.texto}
              {n.emPortugues && <span class="text-texto-secundario"> {t.emPortugues}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</div>
