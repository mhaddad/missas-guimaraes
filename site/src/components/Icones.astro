---
/**
 * Sprite com os ícones usados no site (Material Symbols, Apache 2.0), embutido uma vez na página.
 * Uso: <svg class="icone"><use href="#i-search" /></svg>. Os SVG entram no build (`?raw`):
 * a página é gerada no Worker, sem acesso a arquivos.
 */
import search from "@material-symbols/svg-400/outlined/search.svg?raw";
import close from "@material-symbols/svg-400/outlined/close.svg?raw";
import schedule from "@material-symbols/svg-400/outlined/schedule.svg?raw";
import navigation from "@material-symbols/svg-400/outlined/navigation.svg?raw";
import share from "@material-symbols/svg-400/outlined/share.svg?raw";
import history from "@material-symbols/svg-400/outlined/history.svg?raw";
import keyboardarrowdown from "@material-symbols/svg-400/outlined/keyboard_arrow_down.svg?raw";
import locationon from "@material-symbols/svg-400/outlined/location_on.svg?raw";
import call from "@material-symbols/svg-400/outlined/call.svg?raw";
import church from "@material-symbols/svg-400/outlined/church.svg?raw";
import event from "@material-symbols/svg-400/outlined/event.svg?raw";
import info from "@material-symbols/svg-400/outlined/info.svg?raw";
import flag from "@material-symbols/svg-400/outlined/flag.svg?raw";
import checkcircle from "@material-symbols/svg-400/outlined/check_circle.svg?raw";
import error from "@material-symbols/svg-400/outlined/error.svg?raw";
import arrowforward from "@material-symbols/svg-400/outlined/arrow_forward.svg?raw";
import mail from "@material-symbols/svg-400/outlined/mail.svg?raw";
import language from "@material-symbols/svg-400/outlined/language.svg?raw";

import p_dashboard from "@material-symbols/svg-400/outlined/dashboard.svg?raw";
import p_group from "@material-symbols/svg-400/outlined/group.svg?raw";
import p_logout from "@material-symbols/svg-400/outlined/logout.svg?raw";
import p_open_in_new from "@material-symbols/svg-400/outlined/open_in_new.svg?raw";
import p_edit from "@material-symbols/svg-400/outlined/edit.svg?raw";
import p_delete from "@material-symbols/svg-400/outlined/delete.svg?raw";
import p_add from "@material-symbols/svg-400/outlined/add.svg?raw";
import p_chevron_right from "@material-symbols/svg-400/outlined/chevron_right.svg?raw";
import p_warning from "@material-symbols/svg-400/outlined/warning.svg?raw";
import p_update from "@material-symbols/svg-400/outlined/update.svg?raw";
import p_event_busy from "@material-symbols/svg-400/outlined/event_busy.svg?raw";
import p_verified from "@material-symbols/svg-400/outlined/verified.svg?raw";
import p_calendar_month from "@material-symbols/svg-400/outlined/calendar_month.svg?raw";
import p_image from "@material-symbols/svg-400/outlined/image.svg?raw";
import p_add_photo_alternate from "@material-symbols/svg-400/outlined/add_photo_alternate.svg?raw";
import p_hide_image from "@material-symbols/svg-400/outlined/hide_image.svg?raw";

interface Props {
  /** Ícones só do painel (não pesam nas páginas públicas). */
  painel?: boolean;
}

const { painel = false } = Astro.props;

/** Só no painel. */
const ICONES_PAINEL: Record<string, string> = {
  dashboard: p_dashboard,
  group: p_group,
  logout: p_logout,
  open_in_new: p_open_in_new,
  edit: p_edit,
  delete: p_delete,
  add: p_add,
  chevron_right: p_chevron_right,
  warning: p_warning,
  update: p_update,
  event_busy: p_event_busy,
  verified: p_verified,
  calendar_month: p_calendar_month,
  image: p_image,
  add_photo_alternate: p_add_photo_alternate,
  hide_image: p_hide_image,
};

const ICONES: Record<string, string> = {
  search: search,
  close: close,
  schedule: schedule,
  navigation: navigation,
  share: share,
  history: history,
  keyboard_arrow_down: keyboardarrowdown,
  location_on: locationon,
  call: call,
  church: church,
  event: event,
  info: info,
  flag: flag,
  check_circle: checkcircle,
  error: error,
  arrow_forward: arrowforward,
  mail: mail,
  language: language,
};

const simbolos = Object.entries(painel ? { ...ICONES, ...ICONES_PAINEL } : ICONES)
  .map(([nome, svg]) => {
    const interior = svg.replace(/^<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
    return `<symbol id="i-${nome}" viewBox="0 -960 960 960">${interior}</symbol>`;
  })
  .join("");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  style="display:none"
  set:html={simbolos}
/>
