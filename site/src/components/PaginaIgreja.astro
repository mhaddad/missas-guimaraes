---
/**
 * Página de uma igreja (`/igreja/<id>/`): o detalhe completo, com as celebrações nos dados
 * estruturados. É também a versão sem JavaScript do cartão da página principal e a ligação
 * para partilhar. Lê do D1 só este local (middleware).
 */
import { momentoEmLisboa } from "@missas/horarios";
import Base from "../layouts/Base.astro";
import { TEXTOS, type Idioma } from "../i18n/index.ts";
import { jsonLd } from "../lib/jsonld.ts";
import DetalheLocal from "./DetalheLocal.astro";
import Icone from "./Icone.astro";
import Icones from "./Icones.astro";
import Selo from "./Selo.astro";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = TEXTOS[idioma];
const igreja = Astro.locals.igreja;
const { data: hoje } = momentoEmLisboa(new Date());
if (!igreja) Astro.response.status = 404;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const estruturados =
  igreja &&
  JSON.stringify(jsonLd([igreja], idioma, url, hoje, { urlLocal: () => url })).replace(
    /</g,
    "\\u003c",
  );
const lugar = igreja
  ? [igreja.local.localidade, igreja.local.concelho].filter(Boolean).join(" · ")
  : "";
---

<Base
  titulo={igreja ? `${igreja.local.nome} — ${t.titulo}` : t.titulo}
  descricao={igreja ? `${igreja.local.nome} · ${lugar}` : t.descricao}
  idioma={idioma}
  publico
>
  <Icones />
  <p class="mb-4">
    <a
      class="ligacao inline-flex min-h-12 items-center"
      href={`${t.caminho}${igreja ? `#${igreja.local.id}` : ""}`}
    >
      ← {t.todosOsHorarios}
    </a>
  </p>
  {igreja ? (
    <article class="rounded-cartao border border-borda bg-cartao p-4 md:p-6">
      <h1 class="text-2xl font-bold">{igreja.local.nome}</h1>
      <p class="mt-1 flex items-center gap-1 text-base text-texto-secundario">
        <Icone nome="location_on" class="size-4" />
        {lugar}
      </p>
      <p class="mt-2">
        <Selo
          idioma={idioma}
          confirmadoEm={igreja.local.confirmado_em}
          tipoEntidade={igreja.entidade.tipo}
          hoje={hoje}
          forma="longo"
        />
      </p>
      <DetalheLocal idioma={idioma} local={igreja.local} entidade={igreja.entidade} hoje={hoje} />
    </article>
  ) : (
    <p class="rounded-cartao border border-borda bg-cartao p-6 text-base">
      {t.igrejaNaoEncontrada}
    </p>
  )}
  {estruturados && <script type="application/ld+json" set:html={estruturados} />}
</Base>
