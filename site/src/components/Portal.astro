---
/**
 * Página principal (§6.2): controlos, "A seguir", celebrações do dia por hora, solenidades e
 * rodapé. As celebrações são desenhadas pela ilha `scripts/portal.ts`; sem JavaScript, a página
 * leva à lista das paróquias, onde cada uma tem o horário semanal.
 */
import { momentoEmLisboa } from "@missas/horarios";
import Base from "../layouts/Base.astro";
import { formatar, TEXTOS, type Idioma } from "../i18n/index.ts";
import { dadosPortal, locaisPublicados } from "../lib/dados.ts";
import { formatarDataLonga, formatarDiaEMes } from "../lib/formatos.ts";
import { jsonLd } from "../lib/jsonld.ts";
import { proximasSolenidades } from "../lib/portal.ts";
import Icone from "./Icone.astro";
import Icones from "./Icones.astro";
import Relato from "./Relato.astro";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
/** Chave pública do Turnstile; sem ela, o "Reportar erro" não aparece (E2.9). */
const siteKey = Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
const t = TEXTOS[idioma];
const agora = new Date();
const { data: hoje, hora } = momentoEmLisboa(agora);
const doD1 = Astro.locals.dados;
if (!doD1) throw new Error("Sem dados: o middleware não leu o D1.");
const locais = locaisPublicados(doD1);
const dados = dadosPortal(doD1, agora, hoje);
const solenidades = proximasSolenidades(dados.calendario, hoje);
const urlPagina = new URL(t.caminho, Astro.site).toString();
// Leve: só as igrejas e a ligação para a página da paróquia (lá estão as celebrações).
const estruturados = JSON.stringify(
  jsonLd(locais, idioma, urlPagina, hoje, {
    eventos: false,
    urlLocal: (id) => {
      const entidade = locais.find((l) => l.local.id === id)?.entidade.id ?? id;
      return new URL(`${t.caminho}paroquia/${entidade}/#${id}`, Astro.site).toString();
    },
  }),
).replace(/</g, "\\u003c");
const nomeSolenidade = (s: (typeof solenidades)[number]) =>
  s.preceito ? (s.nome ?? s.id) : ((t.moveis as Record<string, string>)[s.id] ?? s.id);
---

<Base titulo={t.titulo} descricao={t.descricao} idioma={idioma} publico atual="inicio">
  <Icones />

  <noscript>
    <style>
      #controlos,
      #celebracoes-do-dia {
        display: none;
      }
    </style>
    <p class="mb-6 rounded-cartao bg-slate-100 px-4 py-3 text-base">
      {t.semJavaScript}
      <a class="ligacao" href={`${t.caminho}paroquias/`}>
        {t.semJavaScriptLigacao}
      </a>
    </p>
  </noscript>

  <!-- Só se o script da página falhar (scripts/portal.ts): em vez de um espaço em branco. -->
  <div
    id="falha-portal"
    role="alert"
    class="mb-6 rounded-cartao border border-borda bg-cartao px-4 py-3 text-base"
    hidden
  >
    {t.falhaPortal}{" "}
    <a class="ligacao" href={`${t.caminho}paroquias/`}>
      {t.semJavaScriptLigacao}
    </a>
  </div>

  <!-- Controlos: só com JavaScript -->
  <section id="controlos" class="mb-4 rounded-cartao border border-borda bg-cartao p-3 md:p-5">
    <div class="relative">
      <label for="pesquisa" class="sr-only">
        {t.pesquisaRotulo}
      </label>
      <Icone
        nome="search"
        class="pointer-events-none absolute top-1/2 left-3 size-6 -translate-y-1/2 text-texto-secundario"
      />
      <input
        id="pesquisa"
        type="search"
        autocomplete="off"
        placeholder={t.pesquisaExemplo}
        class="min-h-12 w-full rounded-cartao border border-borda bg-superficie pr-12 pl-12 text-base placeholder:text-texto-secundario md:text-body-lg"
      />
      <button
        id="limpar-pesquisa"
        type="button"
        class="absolute top-1/2 right-1 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-cartao text-texto-secundario"
        aria-label={t.limparPesquisa}
        hidden
      >
        <Icone nome="close" class="size-6" />
      </button>
    </div>
    <div class="mt-3 flex flex-col gap-2 md:flex-row md:flex-wrap md:items-center md:gap-x-4 md:gap-y-2">
      <div role="group" aria-label={t.diaRotulo} class="segmentos grid grid-cols-3 md:flex">
        <button type="button" class="segmento segmento-dia" data-dia="hoje" aria-pressed="true">
          {t.hoje}
        </button>
        <button type="button" class="segmento segmento-dia" data-dia="amanha" aria-pressed="false">
          {t.amanha}
        </button>
        <button type="button" class="segmento segmento-dia" data-dia="domingo" aria-pressed="false">
          {t.proximoDomingo}
        </button>
      </div>
      <div
        role="group"
        aria-labelledby="rotulo-concelho"
        class="segmentos grid grid-cols-3 md:flex"
      >
        <span id="rotulo-concelho" class="sr-only">
          {t.concelho}
        </span>
        <button type="button" class="segmento" data-concelho="todos" aria-pressed="true">
          {t.todos}
        </button>
        <button type="button" class="segmento" data-concelho="guimaraes" aria-pressed="false">
          Guimarães
        </button>
        <button type="button" class="segmento" data-concelho="vizela" aria-pressed="false">
          Vizela
        </button>
      </div>
      <button
        type="button"
        id="filtro-tipo"
        class="etiqueta min-h-9 gap-2 self-start bg-azul-fundo text-azul-texto"
        hidden
      >
        <span id="filtro-tipo-texto">{t.filtroConfissoes}</span>
        <Icone nome="close" class="size-4" />
        <span class="sr-only">{t.mostrarTudo}</span>
      </button>
    </div>
  </section>

  <p
    id="faixa-dia-santo"
    class="mb-6 flex items-center gap-3 rounded-cartao bg-aviso-fundo px-4 py-3 text-base font-semibold text-dourado-texto"
    hidden
  >
    <Icone nome="event" class="size-6" />
    <span></span>
  </p>

  <!-- Espaço reservado: as celebrações chegam com o JavaScript sem empurrar o resto. -->
  <div id="celebracoes-do-dia" class="min-h-[100svh]">
    <section id="a-seguir" class="mb-8" aria-live="polite" hidden></section>

    <section id="por-hora" class="mb-10">
      <div class="mb-3 flex items-center justify-between gap-3 md:mb-4">
        <h2 class="text-base font-semibold md:text-xl">
          <span id="titulo-dia"></span>
        </h2>
        <p
          id="ainda-hoje"
          class="shrink-0 rounded-full bg-aviso-fundo px-3 py-1 text-xs font-semibold text-dourado-texto md:text-sm"
          hidden
        ></p>
      </div>
      <ol id="lista-hora" class="grid grid-cols-1 gap-3"></ol>
      <p
        id="vazio-hora"
        class="rounded-cartao border border-dashed border-borda p-6 text-center text-texto-secundario"
        hidden
      ></p>
      <details id="anteriores" class="mt-4 rounded-cartao border border-borda bg-cartao" hidden>
        <summary class="flex min-h-12 cursor-pointer list-none items-center gap-3 px-4 text-base text-texto-secundario [&::-webkit-details-marker]:hidden">
          <Icone nome="history" />
          <span id="anteriores-texto"></span>
          <Icone nome="keyboard_arrow_down" class="ml-auto size-6" />
        </summary>
        <ol id="lista-anteriores" class="grid gap-2 px-4 pb-4"></ol>
      </details>
      <section id="sem-informacao" class="mt-8" hidden>
        <h3 class="text-lg font-semibold">{t.semInformacaoDiaSanto}</h3>
        <p class="mt-1 text-base text-texto-secundario">{t.semInformacaoDiaSantoTexto}</p>
        <ol id="lista-sem-informacao" class="mt-3 grid gap-3"></ol>
      </section>
    </section>
  </div>

  <section
    id="solenidades"
    class="mb-10 scroll-mt-4 rounded-cartao border border-borda bg-cartao p-4 md:p-5"
  >
    <h2 class="text-xl font-semibold">{t.solenidadesTitulo}</h2>
    <p class="mt-1 text-base text-texto-secundario">{t.solenidadesTexto}</p>
    <ul class="mt-4 grid gap-2">
      {solenidades.map((s) => (
        <li class="flex items-center gap-3 border-t border-borda pt-2 md:gap-4">
          <span class="min-w-0 flex-1 md:flex md:items-center md:gap-4">
            <span class="block text-texto-secundario md:w-40 md:shrink-0 md:font-semibold md:text-ardosia">
              {formatarDiaEMes(s.data, idioma)}
            </span>
            <span class="block font-semibold md:font-normal">
              {nomeSolenidade(s)}
              {s.preceito && (
                <span class="etiqueta mt-1 bg-aviso-fundo text-dourado-texto md:mt-0 md:ml-2">
                  {t.diaSantoDePreceito}
                </span>
              )}
            </span>
          </span>
          <a
            class="ligacao inline-flex min-h-12 shrink-0 items-center"
            href={`?dia=${s.data}`}
            data-ir-para-dia={s.data}
          >
            {t.verHorarios}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <footer class="flex flex-wrap items-center justify-between gap-3 border-t border-borda pt-6 text-sm text-texto-secundario">
    <p>{formatar(t.atualizado, { data: formatarDataLonga(hoje, idioma), hora })}</p>
    <p>{t.assinatura}</p>
    {siteKey && (
      <button
        type="button"
        class="ligacao inline-flex min-h-12 items-center gap-1"
        data-relatar=""
        hidden
      >
        <Icone nome="flag" class="size-4" />
        {t.reportarGeral}
      </button>
    )}
    <p class="w-full">{t.semCookies}</p>
  </footer>

  <Relato idioma={idioma} locais={locais.map(({ local }) => local)} />

  <script
    type="application/json"
    id="dados-portal"
    set:html={JSON.stringify(dados).replace(/</g, "\\u003c")}
  />
  <script type="application/ld+json" set:html={estruturados} />
  <script type="application/json" id="idioma-portal" set:html={JSON.stringify({ idioma })} />
</Base>

<script>
  import "../scripts/portal.ts";
</script>
