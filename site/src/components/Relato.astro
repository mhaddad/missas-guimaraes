---
/**
 * Formulário "Reportar erro" (§6.7, E2.9), ligado por `scripts/relato.ts` aos botões
 * `[data-relatar]`. Sem a chave pública do Turnstile, não aparece.
 */
import type { Local } from "@missas/horarios";
import { TEXTOS, type Idioma } from "../i18n/index.ts";

interface Props {
  idioma: Idioma;
  locais: Pick<Local, "id" | "nome" | "localidade">[];
}

const { idioma, locais } = Astro.props;
const t = TEXTOS[idioma];
const siteKey: string | undefined = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || undefined;
---

{siteKey && (
  <dialog
    id="relato"
    data-site-key={siteKey}
    aria-labelledby="relato-titulo"
    class="m-auto max-h-[calc(100dvh-2rem)] w-[min(36rem,calc(100%-2rem))] overflow-y-auto rounded-xl border border-borda bg-cartao p-0 text-ardosia shadow-xl backdrop:bg-ardosia/50"
  >
    <form id="form-relato" class="grid grid-cols-[minmax(0,1fr)] gap-4 p-5 md:p-6" novalidate>
      <h2 id="relato-titulo" class="text-xl font-semibold">
        {t.reportarTitulo}
      </h2>
      <div class="flex flex-col gap-1">
        <label for="relato-local" class="font-semibold">
          {t.reportarIgreja}
        </label>
        <select id="relato-local" name="local" class="campo truncate">
          <option value="">{t.reportarSemIgreja}</option>
          {locais.map((local) => (
            <option value={local.id}>
              {[local.nome, local.localidade].filter(Boolean).join(" · ")}
            </option>
          ))}
        </select>
      </div>
      <div class="flex flex-col gap-1">
        <label for="relato-mensagem" class="font-semibold">
          {t.reportarMensagem}
        </label>
        <textarea
          id="relato-mensagem"
          name="mensagem"
          rows="5"
          minlength="10"
          maxlength="1000"
          required
          aria-describedby="relato-ajuda"
          class="campo py-3"
        />
        <p id="relato-ajuda" class="text-base text-texto-secundario">
          {t.reportarAjuda}
        </p>
      </div>
      <div id="relato-turnstile" class="min-h-16" />
      <p id="relato-estado" role="status" class="text-base font-semibold empty:hidden" />
      <div class="flex flex-wrap justify-end gap-3">
        <button type="button" class="botao-secundario" data-fechar-relato>
          {t.reportarCancelar}
        </button>
        <button type="submit" id="relato-enviar" class="botao-primario">
          {t.reportarEnviar}
        </button>
      </div>
    </form>
  </dialog>
)}
