---
import "../styles/global.css";
import Cabecalho from "../components/Cabecalho.astro";
import Icone from "../components/Icone.astro";
import { IDIOMAS, TEXTOS, type Idioma } from "../i18n/index.ts";
import type { ImagemPartilha } from "../lib/partilha.ts";

interface Props {
  titulo: string;
  descricao: string;
  idioma?: Idioma;
  /** Site público: atalhos, idiomas, `hreflang` e a barra inferior no telemóvel. */
  publico?: boolean;
  /** Caminho da página sem o prefixo do idioma (`paroquias/`, `paroquia/<id>/`); "" é o início. */
  caminho?: string;
  /** Atalho da página atual (cabeçalho e barra inferior). */
  atual?: "inicio" | "paroquias";
  /** Atalhos e barra inferior sem o resto do site público (páginas de erro: sem canónico). */
  navegacao?: boolean;
  /** Imagem de partilha (`og:image`) própria, como a fotografia da igreja; sem ela, a geral. */
  imagem?: ImagemPartilha | undefined;
}

const {
  titulo,
  descricao,
  idioma = "pt-PT",
  publico = false,
  caminho = "",
  atual,
  navegacao = publico,
  imagem,
} = Astro.props;
const t = TEXTOS[idioma];
const absoluto = (caminho: string) => new URL(caminho, Astro.site).toString();
const LOCALES = { "pt-PT": "pt_PT", en: "en_GB", es: "es_ES" } as const;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#0f172a" />
    <title>{titulo}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {publico && (
      <>
        <link rel="canonical" href={absoluto(t.caminho + caminho)} />
        {IDIOMAS.map((i) => (
          <link
            rel="alternate"
            hreflang={TEXTOS[i].idioma}
            href={absoluto(TEXTOS[i].caminho + caminho)}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={absoluto(`/${caminho}`)} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={TEXTOS[idioma].arciprestado} />
        <meta property="og:title" content={titulo} />
        <meta property="og:description" content={descricao} />
        <meta property="og:url" content={absoluto(t.caminho + caminho)} />
        <meta property="og:locale" content={LOCALES[idioma]} />
        {imagem ? (
          <>
            <meta property="og:image" content={absoluto(imagem.url)} />
            <meta property="og:image:alt" content={imagem.alt} />
          </>
        ) : (
          <>
            <meta property="og:image" content={absoluto("/partilha.png")} />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta property="og:image:alt" content={TEXTOS[idioma].arciprestado} />
          </>
        )}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <slot name="head" />
  </head>
  <body class="pb-20 md:pb-0">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded focus:bg-cartao focus:p-3"
    >
      {idioma === "en"
        ? "Skip to content"
        : idioma === "es"
          ? "Saltar al contenido"
          : "Saltar para o conteúdo"}
    </a>
    <Cabecalho idioma={idioma} navegacao={navegacao} caminho={caminho} atual={atual} />
    <main id="conteudo" class="mx-auto max-w-[56rem] px-4 py-6 md:py-8">
      <slot />
    </main>
    <slot name="fim" />
    {navegacao && (
      <nav
        aria-label={t.navegacao}
        class="fixed inset-x-0 bottom-0 z-10 border-t border-borda bg-cartao md:hidden"
      >
        <ul class="grid grid-cols-3">
          {[
            { href: t.caminho, icone: "schedule", texto: t.barraHoje, chave: "inicio" },
            {
              href: `${t.caminho}paroquias/`,
              icone: "church",
              texto: t.barraParoquias,
              chave: "paroquias",
            },
            { href: `${t.caminho}#solenidades`, icone: "event", texto: t.solenidades, chave: "" },
          ].map((item) => (
            <li>
              <a
                class="barra flex min-h-16 w-full flex-col items-center justify-center gap-0.5 text-sm font-semibold"
                href={item.href}
                aria-current={item.chave === atual ? "page" : undefined}
              >
                <Icone nome={item.icone} class="size-6" />
                {item.texto}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </body>
</html>
