---
/**
 * Layout do painel (§7.3), só em pt-PT. O cabeçalho é gerado no servidor a partir da sessão
 * (`Astro.locals.eu`, verificada pelo middleware). Em cima: selo, pessoa e *Sair*; na barra de
 * baixo: as secções conforme o perfil e *Ver o site*.
 */
import "../styles/global.css";
import Icone from "../components/Icone.astro";
import Icones from "../components/Icones.astro";

interface Props {
  titulo: string;
  ativo: "visao" | "paroquias" | "acessos" | "nenhum";
  /** Páginas sem sessão (entrar, sem acesso): sem secções nem conta. */
  simples?: boolean;
  /** Largura do conteúdo: `larga` para listas e a página de uma paróquia. */
  largura?: "normal" | "larga";
}

const { titulo, ativo, simples = false, largura = "larga" } = Astro.props;
const eu = simples ? undefined : Astro.locals.eu;
const admin = eu?.perfil === "admin";
const [unica, ...outras] = eu?.entidades ?? [];
const secoes: { chave: Props["ativo"]; href: string; texto: string; icone: string }[] = admin
  ? [
      { chave: "visao", href: "/admin/", texto: "Visão geral", icone: "dashboard" },
      { chave: "paroquias", href: "/admin/paroquias/", texto: "Paróquias", icone: "church" },
      { chave: "acessos", href: "/admin/acessos/", texto: "Acessos", icone: "group" },
    ]
  : unica && outras.length === 0
    ? [
        {
          chave: "paroquias",
          href: `/admin/paroquia/${unica}/`,
          texto: "A minha paróquia",
          icone: "church",
        },
      ]
    : [
        {
          chave: "paroquias",
          href: "/admin/paroquias/",
          texto: "As minhas paróquias",
          icone: "church",
        },
      ];
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0f172a" />
    <title>{titulo} — Painel dos horários</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="flex min-h-screen flex-col bg-superficie text-base text-ardosia">
    <Icones painel />
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded focus:bg-cartao focus:p-3"
    >
      Saltar para o conteúdo
    </a>
    <header class="sticky top-0 z-20 border-b border-borda bg-cartao/95 backdrop-blur">
      <div class="mx-auto flex max-w-pagina items-center gap-4 px-4 py-2 md:px-6">
        <a
          href={eu ? secoes[0]?.href : "/admin/"}
          class="flex min-h-12 min-w-0 flex-1 items-center gap-3"
        >
          <img
            src="/marca/selo-compacto.svg"
            alt=""
            width="44"
            height="42"
            class="h-9 w-auto shrink-0 md:h-10"
          />
          <span class="min-w-0">
            <span class="block text-sm leading-tight font-bold md:text-base">
              Arciprestado de Guimarães e Vizela
            </span>
            <span class="block text-sm leading-tight font-semibold text-dourado-texto">
              Painel dos horários
            </span>
          </span>
        </a>
        {eu && (
          <div class="flex shrink-0 items-center gap-1">
            <span class="max-w-32 text-right leading-tight sm:max-w-none">
              <span class="block truncate text-sm font-semibold md:text-base">{eu.nome}</span>
              <span class="hidden text-sm text-texto-secundario sm:block">
                {admin ? "Administrador" : "Paróquia"}
              </span>
            </span>
            <form method="post" action="/auth/sair">
              <button
                type="submit"
                class="botao-icone border-transparent"
                aria-label={`Sair (${eu.nome})`}
                title="Sair"
              >
                <Icone nome="logout" />
              </button>
            </form>
          </div>
        )}
      </div>
      {eu && (
        <div class="border-t border-borda">
          <div class="mx-auto flex max-w-pagina items-center gap-1 overflow-x-auto px-4 md:px-6">
            <nav aria-label="Secções do painel">
              <ul class="flex sm:gap-1">
                {secoes.map((s) => (
                  <li>
                    <a
                      class="separador max-sm:px-2"
                      href={s.href}
                      aria-current={ativo === s.chave ? "page" : undefined}
                    >
                      <Icone nome={s.icone} class="hidden size-5 sm:block" />
                      {s.texto}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <a class="separador ml-auto" href="/" target="_blank" rel="noopener" title="Ver o site">
              <Icone nome="open_in_new" class="size-5" />
              <span class="sr-only sm:not-sr-only">Ver o site</span>
              <span class="sr-only">(abre noutro separador)</span>
            </a>
          </div>
        </div>
      )}
    </header>
    <main
      id="conteudo"
      class:list={[
        "mx-auto w-full flex-1 px-4 py-6 md:px-6 md:py-8",
        largura === "larga" ? "max-w-pagina" : "max-w-3xl",
      ]}
    >
      <slot />
    </main>
    <footer class="border-t border-borda bg-cartao">
      <p class="mx-auto max-w-pagina px-4 py-4 text-sm text-texto-secundario md:px-6">
        Arciprestado de Guimarães e Vizela · Cada alteração gravada aparece no site logo a seguir.
      </p>
    </footer>
  </body>
</html>
