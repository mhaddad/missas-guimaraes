---
/**
 * Layout do painel (§7.3), só em pt-PT. O cabeçalho é gerado no servidor a partir da sessão
 * (`Astro.locals.eu`, verificada pelo middleware). Em cima, só o selo e o nome; por baixo, o menu
 * (fixo ao rolar): as secções conforme o perfil, *Ver o site* (só para as paróquias; o administrador
 * tem-no na visão geral), a pessoa (a partir de `md`) e *Sair*. No telemóvel, os itens do menu
 * repartem a largura, com o ícone por cima do texto.
 */
import "../styles/global.css";
import Icone from "../components/Icone.astro";
import Icones from "../components/Icones.astro";

interface Props {
  titulo: string;
  ativo: "visao" | "paroquias" | "relatos" | "acessos" | "nenhum";
  /** Páginas sem sessão (entrar, sem acesso): sem secções nem conta. */
  simples?: boolean;
  /** Largura do conteúdo: `larga` para listas e a página de uma paróquia. */
  largura?: "normal" | "larga";
}

const { titulo, ativo, simples = false, largura = "larga" } = Astro.props;
const eu = simples ? undefined : Astro.locals.eu;
const admin = eu?.perfil === "admin";
const [unica, ...outras] = eu?.entidades ?? [];
const secoes: { chave: Props["ativo"]; href: string; texto: string; icone: string }[] = admin
  ? [
      { chave: "visao", href: "/admin/", texto: "Visão geral", icone: "dashboard" },
      { chave: "paroquias", href: "/admin/paroquias/", texto: "Paróquias", icone: "church" },
      { chave: "relatos", href: "/admin/relatos/", texto: "Relatos", icone: "flag" },
      { chave: "acessos", href: "/admin/acessos/", texto: "Acessos", icone: "group" },
    ]
  : unica && outras.length === 0
    ? [
        {
          chave: "paroquias",
          href: `/admin/paroquia/${unica}/`,
          texto: "A minha paróquia",
          icone: "church",
        },
      ]
    : [
        {
          chave: "paroquias",
          href: "/admin/paroquias/",
          texto: "As minhas paróquias",
          icone: "church",
        },
      ];
const iniciais = (eu?.nome ?? "")
  .split(/\s+/)
  .filter(Boolean)
  .filter((_, i, todas) => i === 0 || i === todas.length - 1)
  .map((p) => p[0]?.toUpperCase())
  .join("");
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0f172a" />
    <title>{titulo} — Painel dos horários</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="flex min-h-screen flex-col bg-superficie text-base text-ardosia">
    <Icones painel />
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:rounded focus:bg-cartao focus:p-3"
    >
      Saltar para o conteúdo
    </a>
    <header class="border-b border-borda bg-cartao">
      <div class="mx-auto flex max-w-pagina items-center px-4 py-2 md:px-6">
        <a href={eu ? secoes[0]?.href : "/admin/"} class="flex min-h-12 min-w-0 items-center gap-3">
          <img
            src="/marca/selo-compacto.svg"
            alt=""
            width="44"
            height="42"
            class="h-8 w-auto shrink-0 md:h-10"
          />
          <span class="min-w-0">
            <span class="block text-sm leading-tight font-bold md:text-base">
              Arciprestado de Guimarães e Vizela
            </span>
            <span class="block text-xs leading-tight font-semibold text-dourado-texto md:text-sm">
              Painel dos horários
            </span>
          </span>
        </a>
      </div>
    </header>
    {eu && (
      <div class="sticky top-0 z-20 border-b border-borda bg-cartao/95 backdrop-blur">
        <div class="mx-auto flex max-w-pagina items-stretch gap-1 px-2 py-1 md:items-center md:gap-2 md:px-6 md:py-1.5">
          <nav
            aria-label="Secções do painel"
            class="flex min-w-0 grow-[var(--n)] basis-0 md:grow-0 md:basis-auto"
            style={`--n: ${secoes.length}`}
          >
            <ul class="flex w-full gap-1">
              {secoes.map((s) => (
                <li class="flex flex-1 md:flex-none">
                  <a
                    class="menu-item"
                    href={s.href}
                    aria-current={ativo === s.chave ? "page" : undefined}
                  >
                    <Icone nome={s.icone} class="size-5" />
                    {s.texto}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div
            class="flex grow-[var(--n)] basis-0 gap-1 md:ml-auto md:grow-0 md:basis-auto md:items-center md:gap-2"
            style={`--n: ${admin ? 1 : 2}`}
          >
            {!admin && (
              <a class="menu-item flex-1 md:flex-none" href="/" target="_blank" rel="noopener">
                <Icone nome="open_in_new" class="size-5" />
                Ver o site
                <span class="sr-only">(abre noutro separador)</span>
              </a>
            )}
            <span class="hidden h-8 w-px bg-borda md:block" aria-hidden="true"></span>
            <span class="hidden items-center gap-2 px-1 md:flex">
              <span
                class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-azul-fundo text-xs font-bold text-azul-texto"
                aria-hidden="true"
              >
                {iniciais}
              </span>
              <span class="leading-tight">
                <span class="block text-sm font-semibold">{eu.nome}</span>
                <span class="block text-xs text-texto-secundario">
                  {admin ? "Administrador" : "Paróquia"}
                </span>
              </span>
            </span>
            <form method="post" action="/auth/sair" class="flex flex-1 md:flex-none">
              <button
                type="submit"
                class="menu-item"
                aria-label={`Sair (${eu.nome})`}
                title={`Sair (${eu.nome})`}
              >
                <Icone nome="logout" class="size-5" />
                Sair
              </button>
            </form>
          </div>
        </div>
      </div>
    )}
    <main
      id="conteudo"
      class:list={[
        "mx-auto w-full flex-1 px-4 py-6 md:px-6 md:py-8",
        largura === "larga" ? "max-w-pagina" : "max-w-3xl",
      ]}
    >
      <slot />
    </main>
    <footer class="border-t border-borda bg-cartao">
      <p class="mx-auto max-w-pagina px-4 py-4 text-sm text-texto-secundario md:px-6">
        Arciprestado de Guimarães e Vizela · Cada alteração gravada aparece no site logo a seguir.
      </p>
    </footer>
  </body>
</html>
