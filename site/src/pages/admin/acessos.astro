---
/** E-9 — Acessos (P8, só administradores): contactos, perfis, entidades e consentimento. */
import Icone from "../../components/Icone.astro";
import Painel from "../../layouts/Painel.astro";
---

<Painel titulo="Acessos" ativo="acessos">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold md:text-3xl">Acessos</h1>
      <p class="mt-1 max-w-3xl text-texto-secundario">
        Quem pode entrar no painel e o que pode editar. Um contacto só é criado depois de a pessoa
        assinar o formulário de adesão. Para tirar o acesso a alguém, mude o estado para{" "}
        <em>suspenso</em>.
      </p>
    </div>
    <button type="button" id="novo-contacto" class="botao-primario">
      <Icone nome="add" />
      Novo contacto
    </button>
  </div>
  <div id="lista-contactos" aria-live="polite">
    <p class="text-texto-secundario">A carregar…</p>
  </div>

  <dialog id="dialogo-contacto" aria-labelledby="titulo-contacto" class="modal">
    <form id="form-contacto" class="modal-conteudo" novalidate>
      <div class="modal-cabecalho">
        <h2 id="titulo-contacto" class="text-xl font-semibold">
          Contacto
        </h2>
        <button
          type="button"
          class="botao-icone -mt-1 -mr-2 border-transparent"
          aria-label="Fechar"
          title="Fechar"
          data-fechar
        >
          <Icone nome="close" />
        </button>
      </div>
      <div class="modal-corpo">
        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-1 text-sm font-bold tracking-wide text-texto-secundario uppercase">
            Nome
            <input name="nome" required maxlength="100" class="campo font-normal" />
          </label>
          <label class="grid gap-1 text-sm font-bold tracking-wide text-texto-secundario uppercase">
            E-mail (conta Google)
            <input name="email" type="email" required maxlength="200" class="campo font-normal" />
          </label>
          <label class="grid gap-1 text-sm font-bold tracking-wide text-texto-secundario uppercase">
            Função
            <select name="funcao" class="campo font-normal">
              <option value="paroco">Pároco</option>
              <option value="secretaria">Secretaria</option>
              <option value="colaborador">Colaborador</option>
              <option value="equipa">Equipa do Arciprestado</option>
            </select>
          </label>
          <label class="grid gap-1 text-sm font-bold tracking-wide text-texto-secundario uppercase">
            Estado
            <select name="estado" class="campo font-normal">
              <option value="ativo">Ativo</option>
              <option value="sem_lembretes">Ativo, sem lembretes por e-mail</option>
              <option value="suspenso">Suspenso (não entra)</option>
              <option value="removido">Removido</option>
            </select>
          </label>
        </div>
        <fieldset class="grid gap-2">
          <legend class="rotulo mb-2">Perfil</legend>
          <label class="flex min-h-12 items-start gap-3 rounded-cartao border border-borda p-3 has-[:checked]:border-ardosia has-[:checked]:bg-superficie">
            <input type="radio" name="perfil" value="entidade" class="mt-1 size-5" checked />
            <span>
              <span class="block font-semibold">Paróquia</span>
              <span class="block text-texto-secundario">
                Vê e edita só as paróquias escolhidas.
              </span>
            </span>
          </label>
          <label class="flex min-h-12 items-start gap-3 rounded-cartao border border-borda p-3 has-[:checked]:border-ardosia has-[:checked]:bg-superficie">
            <input type="radio" name="perfil" value="admin" class="mt-1 size-5" />
            <span>
              <span class="block font-semibold">Administrador</span>
              <span class="block text-texto-secundario">
                Vê e edita todas as paróquias e gere os acessos.
              </span>
            </span>
          </label>
        </fieldset>
        <fieldset class="grid gap-2">
          <legend class="rotulo mb-2">Paróquias</legend>
          <input
            id="filtro-entidades"
            type="search"
            placeholder="Procurar paróquia"
            aria-label="Procurar entidade"
            class="campo"
          />
          <div
            id="lista-entidades"
            class="grid max-h-56 gap-0.5 overflow-y-auto rounded-cartao border-[1.5px] border-slate-300 p-1"
          ></div>
        </fieldset>
        <fieldset class="grid gap-4 md:grid-cols-3">
          <legend class="rotulo mb-2">Consentimento (formulário de adesão)</legend>
          <label class="grid gap-1 text-sm font-semibold">
            Assinado em
            <input name="consentimento_em" type="date" required class="campo" />
          </label>
          <label class="grid gap-1 text-sm font-semibold">
            Versão do formulário
            <input name="consentimento_versao" required maxlength="40" value="v1" class="campo" />
          </label>
          <label class="grid gap-1 text-sm font-semibold">
            Meio
            <select name="consentimento_meio" class="campo">
              <option value="papel">Papel</option>
              <option value="proprio">O próprio (equipa)</option>
            </select>
          </label>
        </fieldset>
        <p
          id="estado-contacto"
          role="status"
          class="text-base font-semibold text-erro empty:hidden"
        ></p>
      </div>
      <div class="modal-rodape">
        <button type="button" class="botao-secundario" data-fechar>
          Cancelar
        </button>
        <button type="submit" class="botao-primario">
          Gravar
        </button>
      </div>
    </form>
  </dialog>
</Painel>

<script>
  import "../../scripts/painel-acessos.ts";
</script>
