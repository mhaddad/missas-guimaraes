---
/** E-1 — Horários (§7.3): *Está tudo certo* (P1), novo/editar/apagar horário (P2) e histórico (E-6). */
import Painel from "../../layouts/Painel.astro";
---

<Painel titulo="Horários" ativo="horarios">
  <div class="mb-6 flex flex-wrap items-end gap-3" id="escolha-entidade" hidden>
    <div class="grid gap-1">
      <label for="entidade" class="text-sm font-bold tracking-wide text-texto-secundario uppercase">
        Entidade
      </label>
      <select
        id="entidade"
        class="min-h-12 min-w-72 rounded-cartao border border-borda bg-cartao px-3 text-base"
      ></select>
    </div>
    <div class="grid gap-1" id="caixa-filtro" hidden>
      <label
        for="filtro-entidade"
        class="text-sm font-bold tracking-wide text-texto-secundario uppercase"
      >
        Procurar
      </label>
      <input
        id="filtro-entidade"
        type="search"
        placeholder="Nome da paróquia"
        class="min-h-12 rounded-cartao border border-borda bg-cartao px-3 text-base"
      />
    </div>
  </div>
  <div id="conteudo-entidade" aria-live="polite">
    <p class="text-texto-secundario">A carregar…</p>
  </div>
  <dialog
    id="dialogo-editor"
    class="m-auto max-h-[calc(100dvh-2rem)] w-[min(44rem,calc(100%-2rem))] overflow-y-auto rounded-xl border border-borda bg-cartao p-0 text-ardosia shadow-xl backdrop:bg-ardosia/50"
  ></dialog>
  <dialog
    id="dialogo-pedido"
    aria-labelledby="titulo-pedido"
    class="m-auto w-[min(40rem,calc(100%-2rem))] rounded-xl border border-borda bg-cartao p-0 text-ardosia shadow-xl backdrop:bg-ardosia/50"
  >
    <form method="dialog" class="grid gap-4 p-5 md:p-6">
      <h2 id="titulo-pedido" class="text-xl font-semibold"></h2>
      <div id="corpo-pedido" class="grid max-h-[60vh] gap-3 overflow-y-auto text-base"></div>
      <div class="flex flex-wrap justify-end gap-3">
        <button value="cancelar" class="botao-secundario">
          Cancelar
        </button>
        <button
          value="confirmar"
          id="confirmar-pedido"
          class="inline-flex min-h-12 items-center rounded-cartao bg-ardosia px-5 text-base font-semibold text-white"
        ></button>
      </div>
    </form>
  </dialog>
</Painel>

<script>
  import "../../scripts/painel-horarios.ts";
</script>
