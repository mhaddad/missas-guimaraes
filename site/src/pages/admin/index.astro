---
/** E-1 — Horários (§7.3), só de leitura no E3. As ações de gravação entram no E4 e no E5. */
import Painel from "../../layouts/Painel.astro";
---

<Painel titulo="Horários" ativo="horarios">
  <div class="mb-6 flex flex-wrap items-end gap-3" id="escolha-entidade" hidden>
    <div class="grid gap-1">
      <label for="entidade" class="text-sm font-bold tracking-wide text-texto-secundario uppercase">
        Entidade
      </label>
      <select
        id="entidade"
        class="min-h-12 min-w-72 rounded-cartao border border-borda bg-cartao px-3 text-base"
      ></select>
    </div>
    <div class="grid gap-1" id="caixa-filtro" hidden>
      <label
        for="filtro-entidade"
        class="text-sm font-bold tracking-wide text-texto-secundario uppercase"
      >
        Procurar
      </label>
      <input
        id="filtro-entidade"
        type="search"
        placeholder="Nome da paróquia"
        class="min-h-12 rounded-cartao border border-borda bg-cartao px-3 text-base"
      />
    </div>
  </div>
  <div id="conteudo-entidade" aria-live="polite">
    <p class="text-texto-secundario">A carregar…</p>
  </div>
</Painel>

<script>
  import "../../scripts/painel-horarios.ts";
</script>
