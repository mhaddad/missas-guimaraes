---
/**
 * Página de uma paróquia no painel (§7.3): *Está tudo certo* (P1), horários habituais com
 * novo/editar/apagar (P2), exceções (P3), dias santos (P4), locais e histórico (E-6). O
 * middleware já verificou que a pessoa pode ver esta entidade; a API volta a verificar.
 */
import Icone from "../../../components/Icone.astro";
import Painel from "../../../layouts/Painel.astro";

const entidade = Astro.locals.entidadePainel;
const admin = Astro.locals.eu?.perfil === "admin";
if (!entidade) Astro.response.status = 404;
---

<Painel titulo={entidade?.nome ?? "Paróquia não encontrada"} ativo="paroquias">
  {!entidade ? (
    <section class="cartao grid gap-3 p-6">
      <h1 class="text-2xl font-bold">Paróquia não encontrada</h1>
      <p class="text-texto-secundario">
        Esta paróquia não existe no painel. Fale com a secretaria do Arciprestado se precisar de
        ajuda.
      </p>
      {admin && (
        <p>
          <a class="botao-secundario" href="/admin/paroquias/">
            Ver todas as paróquias
          </a>
        </p>
      )}
    </section>
  ) : (
    <>
      {admin && (
        <nav aria-label="Caminho" class="mb-4 text-sm">
          <ol class="flex flex-wrap items-center gap-1 text-texto-secundario">
            <li>
              <a class="ligacao" href="/admin/paroquias/">
                Paróquias
              </a>
            </li>
            <li aria-hidden="true">
              <Icone nome="chevron_right" class="size-4" />
            </li>
            <li aria-current="page" class="font-semibold text-ardosia">
              {entidade.nome}
            </li>
          </ol>
        </nav>
      )}
      <div
        id="conteudo-entidade"
        data-entidade={entidade.id}
        data-perfil={admin ? "admin" : "entidade"}
        aria-live="polite"
        aria-busy="true"
      >
        <div class="cartao animate-pulse p-6">
          <div class="h-7 w-2/3 rounded bg-slate-100"></div>
          <div class="mt-3 h-4 w-1/3 rounded bg-slate-100"></div>
          <p class="sr-only">A carregar…</p>
        </div>
      </div>

      <dialog id="dialogo-editor" class="modal"></dialog>
      <dialog id="dialogo-pedido" aria-labelledby="titulo-pedido" class="modal">
        <form method="dialog" class="modal-conteudo">
          <div class="modal-cabecalho">
            <h2 id="titulo-pedido" class="text-xl font-semibold"></h2>
            <button
              value="cancelar"
              class="botao-icone -mt-1 -mr-2 border-transparent"
              aria-label="Fechar"
              title="Fechar"
            >
              <Icone nome="close" />
            </button>
          </div>
          <div id="corpo-pedido" class="modal-corpo text-base"></div>
          <div class="modal-rodape">
            <button value="cancelar" class="botao-secundario">
              Cancelar
            </button>
            <button value="confirmar" id="confirmar-pedido" class="botao-primario"></button>
          </div>
        </form>
      </dialog>
    </>
  )}
</Painel>

<script>
  import "../../../scripts/painel-horarios.ts";
</script>
