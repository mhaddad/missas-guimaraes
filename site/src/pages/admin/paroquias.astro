---
/**
 * Lista das paróquias no painel: todas (administradores) ou as da pessoa. Pesquisa, filtros por
 * concelho e estado da confirmação e ordenação (`scripts/painel-paroquias.ts`, com o estado no
 * endereço). Cada linha leva à página da paróquia. Gerada no servidor (`Astro.locals`).
 */
import { momentoEmLisboa } from "@missas/horarios";
import Icone from "../../components/Icone.astro";
import Painel from "../../layouts/Painel.astro";
import {
  ESTADOS,
  estadoDaConfirmacao,
  formatarData,
  haQuanto,
  ultimaAtualizacao,
} from "../../lib/painel.ts";
import { normalizar } from "../../lib/portal.ts";

const lista = Astro.locals.paroquiasPainel ?? [];
const admin = Astro.locals.eu?.perfil === "admin";
const hoje = momentoEmLisboa(new Date()).data;
const paroquias = lista.map((p) => ({
  ...p,
  estado: estadoDaConfirmacao(p.confirmado_em, hoje),
  atualizada: ultimaAtualizacao(p),
}));
const titulo = admin ? "Paróquias" : "As minhas paróquias";
---

<Painel titulo={titulo} ativo="paroquias">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold md:text-3xl">{titulo}</h1>
      <p id="contagem" class="mt-1 text-texto-secundario" aria-live="polite">
        {paroquias.length} {paroquias.length === 1 ? "paróquia" : "paróquias"}
      </p>
    </div>
  </div>

  {paroquias.length === 0 ? (
    <p class="cartao p-6 text-texto-secundario">
      Ainda não tem nenhuma paróquia associada. Fale com a secretaria do Arciprestado.
    </p>
  ) : (
    <>
      <!-- Filtros -->
      <form
        id="filtros"
        class="cartao mb-4 grid gap-3 p-3 md:grid-cols-[minmax(0,1fr)_auto] md:p-4 lg:grid-cols-[minmax(0,1fr)_auto_auto_auto]"
        role="search"
        aria-label="Filtrar paróquias"
      >
        <div class="relative">
          <label for="pesquisa" class="sr-only">
            Pesquisar paróquias
          </label>
          <Icone
            nome="search"
            class="pointer-events-none absolute top-1/2 left-3 size-5 -translate-y-1/2 text-texto-secundario"
          />
          <input
            id="pesquisa"
            name="q"
            type="search"
            autocomplete="off"
            placeholder="Nome da paróquia ou localidade"
            class="campo pl-10"
          />
        </div>
        <div role="group" aria-label="Concelho" class="segmentos grid grid-cols-3 md:flex">
          <button type="button" class="segmento" data-concelho="todos" aria-pressed="true">
            Todos
          </button>
          <button type="button" class="segmento" data-concelho="guimaraes" aria-pressed="false">
            Guimarães
          </button>
          <button type="button" class="segmento" data-concelho="vizela" aria-pressed="false">
            Vizela
          </button>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 md:col-span-2 lg:col-span-2 lg:flex">
          <label class="grid gap-1">
            <span class="sr-only">Estado</span>
            <select id="estado" name="estado" class="campo lg:w-56">
              <option value="">Todos os estados</option>
              {Object.entries(ESTADOS).map(([chave, e]) => (
                <option value={chave}>{e.texto}</option>
              ))}
            </select>
          </label>
          <label class="grid gap-1">
            <span class="sr-only">Ordenar</span>
            <select id="ordem" name="ordem" class="campo lg:w-80">
              <option value="nome">Ordenar: nome (A–Z)</option>
              <option value="antigas">Ordenar: mais tempo sem atualizar</option>
              <option value="recentes">Ordenar: atualizadas há menos tempo</option>
            </select>
          </label>
        </div>
      </form>

      <!-- Lista: cabeçalho de colunas só em ecrãs largos -->
      <div class="cartao overflow-hidden">
        <div
          class="hidden grid-cols-[minmax(0,2.2fr)_minmax(0,1.2fr)_minmax(0,1.2fr)_5rem_2.75rem] gap-4 border-b border-borda bg-superficie px-5 py-3 md:grid"
          aria-hidden="true"
        >
          <span class="rotulo">Paróquia</span>
          <span class="rotulo">Estado</span>
          <span class="rotulo">Última atualização</span>
          <span class="rotulo text-right">Horários</span>
          <span></span>
        </div>
        <ul id="lista" class="divide-y divide-borda">
          {paroquias.map((p) => (
            <li
              class="paroquia relative grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 px-4 py-3 hover:bg-superficie md:grid-cols-[minmax(0,2.2fr)_minmax(0,1.2fr)_minmax(0,1.2fr)_5rem_2.75rem] md:px-5"
              data-nome={p.nome}
              data-pesquisa={normalizar(
                [p.nome, p.localidade, p.concelho].filter(Boolean).join(" "),
              )}
              data-concelho={p.concelho === "Vizela" ? "vizela" : "guimaraes"}
              data-estado={p.estado}
              data-atualizada={p.atualizada ?? ""}
            >
              <div class="min-w-0">
                <a
                  class="font-semibold after:absolute after:inset-0 hover:underline"
                  href={`/admin/paroquia/${p.id}/`}
                >
                  {p.nome}
                </a>
                <p class="text-sm text-texto-secundario">
                  {[p.localidade, p.concelho].filter(Boolean).join(" · ")}
                  {p.publicados === 0 && " · não publicada"}
                </p>
                {p.sem_dias_santos > 0 && (
                  <p class="mt-1">
                    <span class="etiqueta bg-aviso-fundo text-xs text-dourado-texto">
                      Falta o horário dos dias santos
                    </span>
                  </p>
                )}
              </div>
              <div class="col-start-1 md:col-start-auto">
                <span class:list={["selo-curto", ESTADOS[p.estado].classe]}>
                  {ESTADOS[p.estado].texto}
                </span>
              </div>
              <p class="col-start-1 text-sm text-texto-secundario md:col-start-auto md:text-base md:text-ardosia">
                {p.atualizada ? (
                  <>
                    <span class="md:block">{haQuanto(p.atualizada, hoje)}</span>
                    <span class="hidden text-sm text-texto-secundario md:block">
                      {formatarData(p.atualizada)}
                    </span>
                  </>
                ) : (
                  "Nunca atualizada"
                )}
              </p>
              <p class="hidden text-right tabular-nums md:block">{p.horarios}</p>
              <Icone
                nome="chevron_right"
                class="col-start-2 row-span-3 row-start-1 size-6 text-texto-secundario md:col-start-auto md:row-span-1 md:row-start-auto"
              />
            </li>
          ))}
        </ul>
        <p id="vazio" class="px-5 py-8 text-center text-texto-secundario" hidden>
          Nenhuma paróquia corresponde aos filtros.
          <button type="button" id="limpar-filtros" class="ligacao ml-1 min-h-12">
            Limpar filtros
          </button>
        </p>
      </div>
    </>
  )}
</Painel>

<script>
  import "../../scripts/painel-paroquias.ts";
</script>
