// Worker do projeto (ADR-005): o Astro gera as páginas no servidor; a API, o login Google e os
// relatos ficam em @missas/worker. Dados no D1. Só dois segredos, definidos no painel da
// Cloudflare como *Secret*: GOOGLE_CLIENT_SECRET e TURNSTILE_SECRET.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "missas-guimaraes",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Todos os pedidos passam pelo Worker: noindex na homologação (D26) e a cache das páginas.
    "run_worker_first": true,
  },
  "vars": {
    // "homologacao" até ao E8 (§9.9); em produção passa a "producao".
    "AMBIENTE": "homologacao",
    // Cliente OAuth do Google (público; o segredo é GOOGLE_CLIENT_SECRET).
    "GOOGLE_CLIENT_ID": "",
  },
  "d1_databases": [
    {
      "binding": "BD",
      "database_name": "missas-guimaraes",
      "database_id": "e0eb25fd-ea5d-4077-a3c8-933aec06f7e9",
      "migrations_dir": "../worker/migracoes",
    },
  ],
  "ratelimits": [
    // Relatos do público por IP: 5 por minuto.
    { "name": "LIMITE_RELATOS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Gravações do painel por contacto: 10 por minuto.
    { "name": "LIMITE_PAINEL", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
  ],
  "preview_urls": false,
  "observability": { "enabled": true },
}
