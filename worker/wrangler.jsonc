// Configuração do Worker (PLANO §9.2). Um só Worker serve o site (static assets), a API e os crons.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "missas-guimaraes",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    // Na homologação, todos os pedidos passam pelo Worker para levarem o cabeçalho noindex (D26).
    "run_worker_first": true,
  },
  "vars": {
    // "homologacao" até ao E8 (§9.9); em produção passa a "producao".
    "AMBIENTE": "homologacao",
    // Verificação do JWT do Access (§7.2, E3.2). Não são segredos: o domínio da equipa e o AUD
    // aparecem no próprio redirecionamento para o login. AUD da aplicação "missas-painel", que
    // protege só /admin/* e /api/* (a parte pública da homologação abriu a 12/11).
    "ACCESS_TEAM_DOMAIN": "jolly-mouse-ff5d.cloudflareaccess.com",
    "ACCESS_AUD": "32f09d828bf8e6c970d97324f92656541983bc3643a2124ca6fe9a5a2f06835e",
    // Repositório lido pela GitHub App do painel (§9.5). O App ID não é segredo; a chave privada
    // é um segredo do Worker (GITHUB_PAINEL_APP_PRIVATE_KEY, definido no painel da Cloudflare).
    "GITHUB_REPOSITORIO": "mhaddad/missas-guimaraes",
    "GITHUB_PAINEL_APP_ID": "5710865",
  },
  // Dados privados (§9.3): relatos do público (E2.9) e, a partir do E3, contactos e pedidos.
  // Namespace só da homologação; a produção terá outro (§9.9).
  "kv_namespaces": [{ "binding": "KV", "id": "b44cc9e64bc64d00ba36d03ed477954b" }],
  // Limite de relatos do público por IP (E2.9): 5 por minuto.
  "ratelimits": [
    { "name": "LIMITE_RELATOS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
  // Sem URLs de pré-visualização por versão: ficariam fora da aplicação do Access (D26).
  "preview_urls": false,
  "observability": { "enabled": true },
}
